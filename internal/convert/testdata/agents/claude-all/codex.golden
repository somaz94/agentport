== planner.toml (0644)
name = "planner"
description = "Plans a change, then hands review to another agent."
developer_instructions = '''
Break the request into steps. When something is unclear, ask with AskUserQuestion.

When the plan is done, delegate the review to `code-reviewer`.
'''
